# ============================================================
# Supabase ortam değişkenleri (İLERİDE kullanılacak)
# ------------------------------------------------------------
# Şu anda proje bu değerler OLMADAN da sorunsuz çalışır.
# Supabase entegrasyonu yapıldığında bu dosyayı ".env.local"
# olarak kopyalayıp değerleri doldurun.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sadece sunucu tarafında kullanılacak (service role) - GİZLİ
SUPABASE_SERVICE_ROLE_KEY=
